{
  "name": "ferrum-foundry",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:vite": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "lint": "eslint src server scripts shared e2e",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test scripts/*.test.mjs",
    "check:plugin-schemas": "node scripts/plugin-schema-drift.mjs",
    "check:plugin-sensitivity": "node scripts/plugin-sensitivity-drift.mjs",
    "test:gateway-contract": "node scripts/gateway-contract-smoke.mjs && node scripts/seed-demo-gateway.mjs && node scripts/seed-demo-gateway.mjs && node scripts/verify-demo-gateway.mjs && node scripts/demo-route-smoke.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && npm run test:contracts",
    "e2e": "playwright test",
    "e2e:fault-proxy": "node e2e/fault-proxy.mjs",
    "e2e:gate-self-test": "node scripts/e2e-gate-self-test.mjs",
    "e2e:report": "playwright show-report e2e-report",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "fastify": "^5.12.7",
    "get-nonce": "^1.0.1",
    "jose": "^6.2.12",
    "ky": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.2"
    },
    "shell-quote": "1.12.0"
  }
}
