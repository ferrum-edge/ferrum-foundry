# ------------------------------------------------------------------
# oauth2-proxy settings for the starter's production profile
# ------------------------------------------------------------------
#
# Copy to `oauth2-proxy.env`, fill in, `chmod 600`. Read by oauth2-proxy alone
# through `env_file`, under the names it expects. Keep it separate from `.env`:
# that file holds the gateway admin signing key and the proxy proof secret,
# neither of which oauth2-proxy needs.

# Your OIDC issuer. Foundry never speaks to it; oauth2-proxy does.
OAUTH2_PROXY_OIDC_ISSUER_URL=https://idp.example.com/
OAUTH2_PROXY_EMAIL_DOMAINS=example.com

# The public callback browsers are returned to after login.
OAUTH2_PROXY_REDIRECT_URL=https://foundry.example.com/oauth2/callback

OAUTH2_PROXY_CLIENT_ID=replace-me
OAUTH2_PROXY_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=replace-me-with-32-bytes-base64
