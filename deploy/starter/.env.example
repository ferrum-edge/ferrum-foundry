# ------------------------------------------------------------------
# Ferrum Foundry starter — configuration
# ------------------------------------------------------------------
#
# Copy to `.env` and fill in. Keep `.env` out of version control and give it
# restrictive permissions: it holds the proof secret, which makes its holder a
# gateway administrator.
#
# Nothing here is a working secret. Generate real ones with:
#   openssl rand -base64 48 | tr -d '\n'
#
# For the demo profile, `./bootstrap-demo.sh` writes this file and the nginx
# secret include for you with freshly generated throwaway values.

# ---- Where Foundry reaches the gateway -------------------------------------

# Ferrum Edge admin API origin. Scheme + host + port, no path or query.
# Demo profile: http://demo-gateway:9000
FERRUM_ADMIN_URL=https://ferrum-admin.internal:9000

# Must equal the gateway's FERRUM_ADMIN_JWT_SECRET. 32 characters or more.
FERRUM_JWT_SECRET=replace-me-with-at-least-32-characters-of-random

# Must equal the gateway's FERRUM_ADMIN_JWT_AUDIENCE, when it sets one.
FERRUM_JWT_AUDIENCE=ferrum-admin

# The namespace this deployment administers. It must appear in the namespace
# grants your group-to-namespace policy asserts (nginx/identity/policy.conf).
FERRUM_NAMESPACE=ferrum-foundry-demo

# ---- The trust boundary between the proxy and the BFF ----------------------

# The value the reverse proxy sends in X-Ferrum-Auth-Secret. 32 characters or
# more. Anyone who can reach the BFF port AND knows this value is a gateway
# administrator, so the BFF must publish no host port.
#
# The proxy reads the same value from ./secrets/ferrum-proxy-secret.conf, which
# is a single line:
#     set $ferrum_proxy_secret "<this value>";
FERRUM_TRUSTED_PROXY_SECRET=replace-me-with-at-least-32-characters-of-random

# ---- Identity provider (production profile) --------------------------------

# Your OIDC issuer. Foundry never speaks to it; oauth2-proxy does.
OIDC_ISSUER_URL=https://idp.example.com/
OIDC_EMAIL_DOMAIN=example.com

# The public URL browsers use to reach this deployment.
FOUNDRY_PUBLIC_URL=https://foundry.example.com

# Read by oauth2-proxy through `env_file`. The `foundry` service has no
# env_file, so these never enter the BFF's environment.
OAUTH2_PROXY_CLIENT_ID=replace-me
OAUTH2_PROXY_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=replace-me-with-32-bytes-base64

# Where the SPA sends a user to sign in and out of the proxy.
FERRUM_AUTH_LOGIN_URL=/oauth2/start
FERRUM_AUTH_LOGOUT_URL=/oauth2/sign_out

# ---- Gateway TLS trust -----------------------------------------------------

# Extra trust anchors for the admin API connection, when the gateway presents
# a private certificate. Put the PEM in ./ca/ and point at it here. Leave both
# unset for a publicly trusted chain. Never disable FERRUM_TLS_VERIFY.
FERRUM_TLS_CA_ROOT=
FERRUM_TLS_CA_PATH=

# Send Strict-Transport-Security. Leave true for any deployment behind HTTPS.
FERRUM_ENABLE_HSTS=true

# ---- Demo profile only -----------------------------------------------------

# The throwaway gateway needs this to admit basic-auth credentials.
FERRUM_BASIC_AUTH_HMAC_SECRET=replace-me-with-at-least-32-characters-of-random

# Loopback ports the demo stack publishes.
FOUNDRY_DEMO_PORT=8088
FERRUM_DEMO_PROXY_PORT=8000
FERRUM_DEMO_ADMIN_PORT=9000

# The Foundry image to run. Pin a released digest for production.
FOUNDRY_IMAGE=ferrumedge/ferrum-foundry:main
